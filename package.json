    "express": "^5.2.1",
    "hls.js": "^1.7.3",
    "leaflet": "^1.9.4",
    "multer": "^2.4.0",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.2"
  },
  "engines": {
    "node": ">=24.11.0"
  }
